SECRET_KEY=replace-with-a-long-random-secret
MONGO_URI=mongodb://127.0.0.1:27017/
MONGO_DB_NAME=unnatfarm_mis
UPLOAD_FOLDER=

# Stage 0 defaults: new AVPL workflows remain disabled while legacy routes stay live.
AVPL_PRODUCT_MASTER_V2_ENABLED=false
AVPL_PURCHASE_WORKFLOW_ENABLED=false
AVPL_INVENTORY_LEDGER_ENABLED=false
AVPL_LISTING_WORKFLOW_ENABLED=false
AVPL_SALES_ACCOUNTING_ENABLED=false
AVPL_REPORTS_ENABLED=false
LEGACY_PRODUCT_RESTOCK_ENABLED=true
LEGACY_DIRECT_AVPL_ORDER_ENABLED=true
